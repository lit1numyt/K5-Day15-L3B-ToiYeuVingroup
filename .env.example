# Nối model thật cho L1 (copy file này thành .env rồi điền). KHÔNG commit .env.
# Sau khi điền, chạy:  python scripts/demo/build_demo.py   (phải thấy token in/out > 0)

# --- Chọn 1 nhà cung cấp ---

# OpenAI (hoặc endpoint OpenAI-compatible: VinAI nội bộ, OpenRouter, vLLM...)
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.4-nano
API_KEY=
# API_BASE=https://api.openai.com/v1      # đổi nếu dùng endpoint khác (OpenAI-compatible)

# Claude (Anthropic)
# MODEL_PROVIDER=anthropic
# MODEL_NAME=claude-haiku-5-5
# API_KEY=

# Model chạy trên máy (Ollama) — không cần API_KEY
# MODEL_PROVIDER=ollama
# MODEL_NAME=llama3.1
# API_BASE=http://localhost:11434
