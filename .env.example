# Sao chép file này thành `.env` ở thư mục gốc repo rồi điền thông tin thật.
# KHÔNG commit file `.env` lên Git.

# Chọn 1 trong các provider: anthropic (hoặc claude), openai, gemini, ollama, fake

# --- 1. Anthropic Claude (mặc định đang chọn) ---
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-haiku-4-5-20251001
API_KEY=

# --- 2. OpenAI ---
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-4o-mini
# API_KEY=

# --- 3. Google Gemini (có free tier trên Google AI Studio) ---
# MODEL_PROVIDER=gemini
# MODEL_NAME=gemini-3.8-flash
# API_KEY=

# --- 4. Ollama (chạy local trên máy, không cần API_KEY) ---
# MODEL_PROVIDER=ollama
# MODEL_NAME=qwen2.5:7b
# API_KEY=

# --- 5. Chế độ giả (chỉ dùng kiểm khung offline, không tính eval/simulate) ---
# MODEL_PROVIDER=fake

# Tuỳ chọn nâng cao:
# MAX_TOKENS=2048
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# OLLAMA_BASE_URL=http://localhost:11434/api/chat
# API_BASE=https://api.openai.com/v1
# API_BASE là URL gốc cho OpenAI-compatible hoặc Ollama.
# OPENAI_BASE_URL / OLLAMA_BASE_URL là endpoint đầy đủ, được ưu tiên khi có.
